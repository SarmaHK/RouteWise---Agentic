# RouteWise Agentic — backend environment template (Phase A1 foundation)
# Copy this file to `.env` (gitignored) and fill in real values. NEVER commit `.env`.
# See docs/DEVELOPMENT_RULES.md (Environment & secrets).

# --- Alibaba Cloud Model Studio / Qwen (Workstream A) ---
# Leave the key EMPTY for local development: the AI service falls back to a safe mock.
MODEL_STUDIO_API_KEY=

# OpenAI-compatible Model Studio endpoint (international). Confirm the region URL you use.
MODEL_STUDIO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen model id. PROJECT.md references the "Qwen Max" tier; confirm the exact id in Model Studio.
MODEL_NAME=qwen-max

# --- Backend app ---
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS for local frontend development.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (Workstream B) ---
DATABASE_URL=postgresql://routewise:routewise_pass@localhost:5432/routewise_transit

# --- Transit Intelligence & ML (Workstream B) ---
ENABLE_TRANSIT_INTELLIGENCE=true

# --- Autonomous Execution & Cloud (Workstream C) ---
ENABLE_AUTONOMOUS_EXECUTION=true

