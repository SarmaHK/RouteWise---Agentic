# RouteWise Agentic — frontend environment template (Phase A1 foundation)
# Copy to `.env.local` (gitignored) to override. Vite exposes ONLY VITE_*-prefixed vars.
# NEVER put secrets or API keys here — the frontend must not hold credentials
# (docs/DEVELOPMENT_RULES.md -> Environment & secrets).

# Base URL of the FastAPI backend for local development.
VITE_API_BASE_URL=http://localhost:8000
